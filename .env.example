# 后端环境变量模板 —— 复制为 .env 并填入真实值
#   cp .env.example .env
# .env 已被 gitignore,不会进仓库,也不要贴到聊天里。

# 进入网站的口令(前端首屏输入;留空则不校验)
APP_PASSCODE=demo

# LLM:任选一家,填对应 key(其余可留空)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Cloudflare R2(S3 兼容)
# auto: R2 全部未配置时保存在本机；全部配置时用 R2；部分配置会报错。
# local: 始终保存到本机；r2: 要求完整 R2 配置。
AUDIO_STORAGE=auto
# LOCAL_AUDIO_DIR=C:\music\audio
# Windows 启动脚本未指定时默认使用 0.6B；可显式覆盖。
# ACESTEP_LM_MODEL=acestep-5Hz-lm-0.6B
# R2_ACCOUNT_ID = 你 S3 端点里 .r2.cloudflarestorage.com 前面那一串
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# R2_BUCKET = 你建的存储桶名字
R2_BUCKET=
# R2_PUBLIC_BASE = 存储桶开启公开访问后的地址,如 https://pub-xxxx.r2.dev
R2_PUBLIC_BASE=

# CORS:部署时填 Vercel 域名(逗号分隔);本地开发可留 *
CORS_ORIGINS=*

# ACE-Step VAE 变体(可选):留空 = 官方 VAE;scragvae = 社区微调解码器(高频/人声更清楚)
# 首次使用需下载到 ACE-Step-1.5/checkpoints/scragvae/(国内可设 HF_ENDPOINT=https://hf-mirror.com)
# ACESTEP_VAE_CHECKPOINT=scragvae
